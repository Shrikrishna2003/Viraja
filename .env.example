SECRET_KEY=change-me-to-a-long-random-string
# Production: SECRET_KEY must be 32+ random characters or the app refuses to start.
# Gmail: turn on 2-Step Verification, then create an App Password (Google Account > Security)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM=you@gmail.com
# Optional: turns on Krish's AI agent mode
ANTHROPIC_API_KEY=
